{
  "$comment": "Comprehensive credential example - Demonstrates all SEAM credential and authentication extensions working together.",
  "description": "Complete example showing all four credential and auth extensions (x-vault-path, x-inject-as, x-credential-probe, x-required-scope) in a single fragment. This pattern is used for secured external API integration with proactive credential validation and scope-based authorization.",
  "x-seam-schema": "v1",
  "x-seam-owner": "payment-processor",
  "x-api-version": "v1",
  "x-upstream": "https://api.payment-provider.example.com",
  "x-vault-path": "seam/routes/payment-processor/api-secret",
  "x-inject-as": {
    "kind": "header",
    "name": "x-api-secret"
  },
  "x-credential-probe": {
    "path": "/v1/health",
    "method": "HEAD",
    "interval": "180s"
  },
  "x-required-scope": "payment:read",
  "x-breaker": {
    "threshold": 5,
    "openSeconds": 60,
    "maxOpenSeconds": 300,
    "enabled": true
  },
  "paths": {
    "/v1/payments": {
      "get": {
        "summary": "List payments with default scope",
        "description": "Returns a paginated list of payments. Uses the fragment-level default scope (payment:read) unless overridden at the operation level.",
        "operationId": "listPayments",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 },
            "description": "Maximum number of payments to return"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Pagination cursor for next page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of payments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["payments", "next_cursor"],
                  "properties": {
                    "payments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "amount": { "type": "number" },
                          "currency": { "type": "string" },
                          "status": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    },
                    "next_cursor": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired API secret"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "post": {
        "summary": "Create payment with elevated scope",
        "description": "Creates a new payment. This operation requires the elevated payment:write scope, overriding the fragment-level default.",
        "operationId": "createPayment",
        "x-required-scope": "payment:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "currency", "payment_method_id"],
                "properties": {
                  "amount": { "type": "number", "minimum": 0.01 },
                  "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                  "payment_method_id": { "type": "string" },
                  "description": { "type": "string" },
                  "metadata": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status", "created_at"],
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string", "enum": ["pending", "processing", "succeeded", "failed"] },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid payment data"
          },
          "401": {
            "description": "Invalid or expired API secret"
          },
          "403": {
            "description": "Insufficient scope (requires payment:write)"
          }
        }
      }
    },
    "/v1/payments/{payment_id}": {
      "get": {
        "summary": "Get payment details",
        "description": "Retrieves details for a specific payment. Uses the fragment-level default scope (payment:read).",
        "operationId": "getPayment",
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Payment ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "amount", "currency", "status", "created_at"],
                  "properties": {
                    "id": { "type": "string" },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "status": { "type": "string" },
                    "description": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" },
                    "updated_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment not found"
          }
        }
      },
      "delete": {
        "summary": "Cancel payment with elevated scope",
        "description": "Cancels a pending payment. This operation requires the elevated payment:write scope, overriding the fragment-level default.",
        "operationId": "cancelPayment",
        "x-required-scope": "payment:write",
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Payment ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string", "const": "cancelled" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Payment cannot be cancelled (wrong state)"
          },
          "403": {
            "description": "Insufficient scope (requires payment:write)"
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Health check endpoint (used by credential probe)",
        "description": "Safe endpoint used by x-credential-probe to validate credentials. HEAD requests are lightweight and return minimal status. The credential probe polls this endpoint every 180 seconds to detect credential rotation or expiry before client requests fail with 401.",
        "operationId": "healthCheck",
        "x-required-scope": "payment:read:health",
        "responses": {
          "200": {
            "description": "Service healthy, credentials valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "const": "ok" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credentials invalid or expired (triggers credential refresh)"
          },
          "503": {
            "description": "Service unavailable (circuit breaker open)"
          }
        }
      }
    },
    "/v1/refunds": {
      "post": {
        "summary": "Create refund with admin scope",
        "description": "Creates a refund for a payment. This operation requires the admin-level payment:admin scope, overriding the fragment-level default.",
        "operationId": "createRefund",
        "x-required-scope": "payment:admin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["payment_id", "amount"],
                "properties": {
                  "payment_id": { "type": "string" },
                  "amount": { "type": "number", "minimum": 0.01 },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Refund created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "status"],
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string" },
                    "amount": { "type": "number" },
                    "currency": { "type": "string" },
                    "created_at": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid refund data"
          },
          "403": {
            "description": "Insufficient scope (requires payment:admin)"
          },
          "404": {
            "description": "Payment not found"
          }
        }
      }
    }
  }
}
