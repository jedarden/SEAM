{
  "$comment": "Route with credential probing - Demonstrates proactive credential validation by polling a safe endpoint.",
  "description": "Route fragment with x-credential-probe enabled. This SEAM extension proactively validates credentials against the upstream by polling a designated safe endpoint, detecting credential rotation or expiry before clients encounter 401 errors.",
  "x-seam-schema": "v1",
  "x-seam-owner": "weather-service",
  "x-api-version": "v1",
  "x-upstream": "https://weather.api.example.com",
  "x-vault-path": "seam/routes/weather-service/api-token",
  "x-inject-as": {
    "kind": "bearer"
  },
  "x-credential-probe": {
    "path": "/health",
    "method": "GET",
    "interval": "300s"
  },
  "x-breaker": {
    "threshold": 5,
    "openSeconds": 60,
    "maxOpenSeconds": 300,
    "enabled": true
  },
  "paths": {
    "/forecast": {
      "get": {
        "summary": "Get weather forecast",
        "description": "Returns weather forecast data. Credentials are proactively validated every 5 minutes via the /health endpoint.",
        "operationId": "getForecast",
        "x-required-scope": "weather:read:forecast",
        "responses": {
          "200": {
            "description": "Weather forecast data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temperature": { "type": "number" },
                    "conditions": { "type": "string" },
                    "humidity": { "type": "number" },
                    "windSpeed": { "type": "number" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired API token"
          },
          "503": {
            "description": "Service unavailable (circuit breaker open)"
          }
        }
      }
    },
    "/current": {
      "get": {
        "summary": "Get current weather conditions",
        "description": "Returns current weather conditions for a location.",
        "operationId": "getCurrentConditions",
        "x-required-scope": "weather:read:current",
        "responses": {
          "200": {
            "description": "Current conditions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temp": { "type": "number" },
                    "condition": { "type": "string" },
                    "humidity": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check endpoint (used by credential probe)",
        "description": "Safe endpoint used by x-credential-probe to validate credentials. Requires minimal quota and returns lightweight status.",
        "operationId": "healthCheck",
        "x-required-scope": "weather:read:health",
        "responses": {
          "200": {
            "description": "Service healthy, credentials valid"
          },
          "401": {
            "description": "Credentials invalid or expired"
          }
        }
      }
    }
  }
}
