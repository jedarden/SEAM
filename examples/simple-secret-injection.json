{
  "$comment": "Simple secret-injecting route - Generic pattern for API gateway routes that inject credentials and forward requests.",
  "description": "Simple pass-through proxy that injects an API key from OpenBao and forwards all requests to the upstream. This is the generic pattern used by services like twitterapi-proxy.",
  "x-seam-schema": "v1",
  "x-seam-owner": "external-api",
  "x-api-version": "v1",
  "x-upstream": "https://api.example.com",
  "x-vault-path": "seam/routes/external-api/api-key",
  "x-inject-as": {
    "kind": "header",
    "name": "x-api-key"
  },
  "paths": {
    "/v1/{proxy+}": {
      "get": {
        "summary": "Proxy GET requests to upstream API",
        "description": "Forwards GET requests to the upstream API, injecting the API key header. All paths are matched and forwarded verbatim.",
        "operationId": "proxyGet",
        "x-required-scope": "external-api:proxy:read",
        "responses": {
          "200": {
            "description": "Upstream response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "post": {
        "summary": "Proxy POST requests to upstream API",
        "description": "Forwards POST requests to the upstream API, injecting the API key header.",
        "operationId": "proxyPost",
        "x-required-scope": "external-api:proxy:write",
        "responses": {
          "200": {
            "description": "Upstream response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Invalid API key"
          }
        }
      },
      "put": {
        "summary": "Proxy PUT requests to upstream API",
        "description": "Forwards PUT requests to the upstream API, injecting the API key header.",
        "operationId": "proxyPut",
        "x-required-scope": "external-api:proxy:write",
        "responses": {
          "200": {
            "description": "Upstream response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          }
        }
      }
    }
  }
}
