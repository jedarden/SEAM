{
  "openapi": "3.1.0",
  "info": {
    "title": "External Metrics API",
    "version": "1.0.0",
    "description": "Proxy to external metrics service with API key injection from OpenBao."
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "metrics-proxy",
  "x-api-version": "v1",
  "x-upstream": "https://metrics.external-service.com",
  "x-vault-path": "rs-manager/rs-manager/seam/routes/metrics-proxy/api-key",
  "x-inject-as": {
    "kind": "header",
    "name": "X-API-Key"
  },
  "x-credential-probe": {
    "path": "/v1/health",
    "method": "GET",
    "interval": "10m"
  },
  "paths": {
    "/v1/metrics/{service}": {
      "get": {
        "summary": "Get metrics for a service",
        "operationId": "getServiceMetrics",
        "parameters": [
          {
            "name": "service",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          {
            "name": "window",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["1h", "6h", "24h", "7d"]
            },
            "description": "Time window for metrics aggregation"
          }
        ],
        "responses": {
          "200": {
            "description": "Metrics data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "service": { "type": "string" },
                    "window": { "type": "string" },
                    "metrics": {
                      "type": "object",
                      "properties": {
                        "requests": { "type": "integer" },
                        "errors": { "type": "integer" },
                        "latency_p50": { "type": "number" },
                        "latency_p95": { "type": "number" },
                        "latency_p99": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters"
          },
          "404": {
            "description": "Service not found"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Health check endpoint",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
