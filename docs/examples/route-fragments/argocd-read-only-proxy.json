{
  "openapi": "3.1.0",
  "info": {
    "title": "ArgoCD Read-Only Proxy",
    "version": "1.0.0",
    "description": "Phase 3 migration target: read-only proxy to ArgoCD API over Tailscale. No secret injection — pure pass-through with read-only RBAC.",
    "contact": {
      "name": "SEAM Gateway",
      "email": "seam@ardenone.com"
    }
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "argocd-proxy",
  "x-api-version": "v1",
  "x-upstream": "https://argocd-ro-ardenone-manager-ts.ardenone.com:8444",
  "x-upstream-strip-prefix": "/argocd",
  "paths": {
    "/argocd/api/v1/applications": {
      "get": {
        "summary": "List all ArgoCD applications",
        "description": "Returns all applications visible to the read-only bearer token injected by the Tailscale proxy.",
        "operationId": "listApplications",
        "tags": ["applications"],
        "x-required-scope": "argocd:read",
        "responses": {
          "200": {
            "description": "List of applications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/argocd/api/v1/applications/{name}": {
      "get": {
        "summary": "Get a specific application",
        "operationId": "getApplication",
        "tags": ["applications"],
        "x-required-scope": "argocd:read",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Application name"
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    },
    "/argocd/api/v1/clusters": {
      "get": {
        "summary": "List all clusters",
        "operationId": "listClusters",
        "tags": ["clusters"],
        "x-required-scope": "argocd:read",
        "responses": {
          "200": {
            "description": "List of clusters",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  }
}
