{
  "openapi": "3.1.0",
  "info": {
    "title": "Kubernetes API Proxy with Credential Probing",
    "version": "1.0.0",
    "description": "Proxies to Kubernetes clusters with per-cluster service account tokens and aggressive credential health checking via probing."
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "k8s-proxy",
  "x-api-version": "v1",
  "x-instance-param": "cluster",
  "x-upstream-map": {
    "production": {
      "url": "https://kubernetes.default.svc",
      "vaultPath": "seam/routes/k8s-proxy/production-token",
      "injectAs": {
        "kind": "bearer"
      },
      "tls": {
        "caBundle": "production-ca",
        "serverName": "kubernetes.production.svc.cluster.local"
      },
      "probeInterval": "15s"
    },
    "staging": {
      "url": "https://kubernetes.staging.svc.cluster.local",
      "vaultPath": "seam/routes/k8s-proxy/staging-token",
      "injectAs": {
        "kind": "bearer"
      },
      "tls": {
        "caBundle": "staging-ca"
      },
      "probeInterval": "30s"
    },
    "development": {
      "url": "https://kubernetes.development.svc.cluster.local",
      "vaultPath": "seam/routes/k8s-proxy/development-token",
      "injectAs": {
        "kind": "bearer"
      },
      "probeInterval": "60s"
    }
  },
  "x-upstream-strip-prefix": "/k8s",
  "x-credential-probe": {
    "path": "/api/v1/namespaces/default",
    "method": "GET",
    "interval": "30s"
  },
  "x-breaker": {
    "threshold": 5,
    "openSeconds": 30,
    "maxOpenSeconds": 300
  },
  "paths": {
    "/k8s/api/v1/namespaces": {
      "get": {
        "summary": "List namespaces",
        "operationId": "listNamespaces",
        "tags": ["core"],
        "x-required-scope": "k8s-ro:get",
        "responses": {
          "200": {
            "description": "List of namespaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/k8s/api/v1/namespaces/{namespace}/pods": {
      "get": {
        "summary": "List pods in a namespace",
        "operationId": "listPods",
        "tags": ["core"],
        "x-required-scope": "k8s-ro:get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Namespace name"
          }
        ],
        "responses": {
          "200": {
            "description": "List of pods",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/k8s/apis/apps/v1/namespaces/{namespace}/deployments": {
      "get": {
        "summary": "List deployments in a namespace",
        "operationId": "listDeployments",
        "tags": ["apps"],
        "x-required-scope": "k8s-ro:get",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of deployments",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  }
}
