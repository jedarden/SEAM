{
  "openapi": "3.1.0",
  "info": {
    "title": "GitHub Repository Webhook Ingestion",
    "version": "1.0.0",
    "description": "Accepts GitHub webhook events and validates them using a shared secret injected from OpenBao."
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "webhook-ingest",
  "x-api-version": "v1",
  "x-upstream": "https://webhook-ingest.internal.ardenone.com",
  "x-upstream-strip-prefix": "/hooks/github",
  "x-vault-path": "seam/routes/webhook-ingest/github-webhook-secret",
  "x-inject-as": {
    "kind": "header",
    "name": "X-Hub-Signature-256"
  },
  "x-credential-probe": {
    "path": "/health",
    "method": "GET",
    "interval": "30s"
  },
  "paths": {
    "/hooks/github/{org}/{repo}": {
      "post": {
        "summary": "Ingest GitHub webhook for a repository",
        "operationId": "ingestGitHubWebhook",
        "tags": ["webhooks"],
        "x-required-scope": "webhook:ingest",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "GitHub organization name"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "GitHub repository name"
          },
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Webhook event type"
          },
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "HMAC signature of payload (client-provided, validated upstream)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Webhook accepted for processing"
          },
          "401": {
            "description": "Invalid signature"
          }
        }
      }
    },
    "/hooks/github/health": {
      "get": {
        "summary": "Health check endpoint",
        "operationId": "healthCheck",
        "tags": ["health"],
        "x-required-scope": "system:health",
        "responses": {
          "200": {
            "description": "Service healthy"
          }
        }
      }
    }
  }
}
