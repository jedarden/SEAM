{
  "openapi": "3.1.0",
  "info": {
    "title": "ArgoCD Read-Only Proxy",
    "version": "1.0.0",
    "description": "Read-only proxy to ArgoCD API at https://argocd-ro-ardenone-manager-ts.ardenone.com:8444. This is the Phase 3 migration target for replacing direct kubectl-proxy access with a scoped, secret-injected SEAM route.",
    "contact": {
      "name": "SEAM Gateway Team",
      "email": "seam@ardenone.com"
    }
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "argocd-proxy",
  "x-api-version": "v1",
  "x-upstream": "https://argocd-ro-ardenone-manager-ts.ardenone.com:8444",
  "x-vault-path": "rs-manager/rs-manager/seam/routes/argocd-proxy/readonly-token",
  "x-inject-as": {
    "kind": "bearer"
  },
  "x-credential-probe": {
    "path": "/api/v1/applications",
    "method": "GET",
    "interval": "5m"
  },
  "x-breaker": {
    "threshold": 10,
    "openSeconds": 30,
    "maxOpenSeconds": 300,
    "enabled": true
  },
  "x-required-scope": "argocd:read",
  "paths": {
    "/api/v1/applications": {
      "get": {
        "summary": "List all ArgoCD applications",
        "description": "Returns a list of all applications the caller is authorized to see. This is the primary discovery endpoint used by seam lint and the /docs UI.",
        "operationId": "listApplications",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "metadata": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "namespace": { "type": "string" }
                            }
                          },
                          "status": {
                            "type": "object",
                            "properties": {
                              "health": { "type": "string" },
                              "sync": { "type": "object" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing bearer token"
          },
          "403": {
            "description": "Forbidden - caller lacks argocd:read scope"
          }
        }
      }
    },
    "/api/v1/applications/{name}": {
      "get": {
        "summary": "Get a specific application",
        "operationId": "getApplication",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Application name"
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    },
    "/api/v1/clusters": {
      "get": {
        "summary": "List ArgoCD-managed clusters",
        "description": "Returns all clusters registered with ArgoCD. Used for cluster inventory and validation.",
        "operationId": "listClusters",
        "responses": {
          "200": {
            "description": "Cluster list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
