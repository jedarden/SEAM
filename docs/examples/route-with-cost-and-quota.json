{
  "openapi": "3.1.0",
  "info": {
    "title": "Expensive LLM API",
    "version": "1.0.0",
    "description": "Proxy to expensive LLM service with per-call cost tracking and quota enforcement. This route demonstrates SEAM's cost control features for external API gateways."
  },
  "x-seam-schema": "v1",
  "x-seam-owner": "llm-gateway",
  "x-api-version": "v1",
  "x-upstream": "https://api.llm-provider.com",
  "x-vault-path": "seam/routes/llm-gateway/api-key",
  "x-inject-as": {
    "kind": "bearer"
  },
  "x-credential-probe": {
    "path": "/v1/models",
    "method": "GET",
    "interval": "15m"
  },
  "x-required-scope": "llm:generate",
  "paths": {
    "/v1/completions": {
      "post": {
        "summary": "Generate text completion",
        "description": "High-cost endpoint: each call costs 100 credits. Quota is enforced per scope.",
        "operationId": "createCompletion",
        "x-cost-per-call": 100,
        "x-quota": {
          "limit": 10000,
          "window_seconds": 3600
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "prompt"],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model identifier"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Input prompt"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096,
                    "default": 256
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 1.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": { "type": "string" },
                          "finish_reason": { "type": "string" }
                        }
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": { "type": "integer" },
                        "completion_tokens": { "type": "integer" },
                        "total_tokens": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "402": {
            "description": "Quota exceeded - insufficient credits for this call"
          },
          "500": {
            "description": "LLM provider error"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Generate chat completion",
        "description": "Higher-cost endpoint with multi-turn conversation support. Costs 150 credits per call.",
        "operationId": "createChatCompletion",
        "x-cost-per-call": 150,
        "x-quota": {
          "limit": 15000,
          "window_seconds": 3600
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["system", "user", "assistant"]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "description": "Quota exceeded"
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "summary": "Generate text embeddings",
        "description": "Lower-cost endpoint for vector embeddings. Costs 10 credits per call.",
        "operationId": "createEmbedding",
        "x-cost-per-call": 10,
        "x-quota": {
          "limit": 50000,
          "window_seconds": 3600
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["input", "model"],
                "properties": {
                  "input": {
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    ]
                  },
                  "model": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embeddings generated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
