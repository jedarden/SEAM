{
  "$comment": "Complex SEAM fragment with all extensions - demonstrates comprehensive SEAM configuration",
  "description": "Complete example showing all major SEAM extension fields working together",
  "x-seam-schema": "v1",
  "x-seam-owner": "weather-service",
  "x-api-version": "v1",
  "x-instance-param": "region",
  "x-upstream-map": {
    "us-east": {
      "url": "https://weather.api.example.com",
      "vaultPath": "seam/routes/weather-service/api-token",
      "injectAs": {
        "kind": "bearer"
      },
      "target_host": "weather.api.example.com",
      "rewrite_path": "/api/v1/forecast",
      "requiredScope": "weather:read:us-east"
    },
    "eu-west": {
      "url": "https://weather.eu.example.com",
      "vaultPath": "seam/routes/weather-service/eu-token",
      "injectAs": {
        "kind": "bearer"
      },
      "target_host": "weather.eu.example.com",
      "rewrite_path": "/api/v1/forecast",
      "requiredScope": "weather:read:eu-west"
    }
  },
  "x-fanout-scope": ["weather:read:all"],
  "x-upstream-tls": {
    "caBundle": "weather-api.pem",
    "serverName": "weather.api.example.com"
  },
  "x-breaker": {
    "threshold": 10,
    "openSeconds": 30,
    "enabled": true
  },
  "x-required-scope": ["weather:query:data"],
  "paths": {
    "/forecast/{region}": {
      "get": {
        "summary": "Get weather forecast with comprehensive rate limiting and cost tracking",
        "operationId": "getForecast",
        "x-loop-guard": {
          "max_iterations": 10,
          "backoff_ms": 100
        },
        "x-cost-per-call": 0.001,
        "x-quota": {
          "limit": 1000,
          "window_seconds": 3600
        },
        "parameters": [
          {
            "name": "region",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful forecast response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temperature": { "type": "number" },
                    "conditions": { "type": "string" },
                    "humidity": { "type": "number" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  }
}
