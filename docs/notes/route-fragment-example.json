{
  "$comment": "Complete example SEAM route fragment demonstrating all five extensions: x-seam-schema, x-upstream-map, x-loop-guard, x-cost-per-call, and x-quota.",
  "description": "This is a valid example showing all five SEAM extensions working together in a single fragment.",
  "x-seam-schema": "v1",
  "x-seam-owner": "weather-service",
  "x-api-version": "v1",
  "x-instance-param": "region",
  "x-upstream-map": {
    "us-east": {
      "url": "https://weather.api.example.com",
      "vaultPath": "seam/routes/weather-service/api-token",
      "injectAs": {
        "kind": "bearer"
      },
      "target_host": "weather.api.example.com",
      "rewrite_path": "/api/v1/forecast",
      "requiredScope": "weather:read:us-east"
    },
    "eu-west": {
      "url": "https://weather.eu.example.com",
      "vaultPath": "seam/routes/weather-service/eu-token",
      "injectAs": {
        "kind": "bearer"
      },
      "target_host": "weather.eu.example.com",
      "rewrite_path": "/api/v1/forecast",
      "requiredScope": "weather:read:eu-west"
    },
    "ap-southeast": {
      "url": "https://weather.ap.example.com",
      "vaultPath": "seam/routes/weather-service/ap-token",
      "injectAs": {
        "kind": "bearer"
      },
      "target_host": "weather.ap.example.com",
      "rewrite_path": "/api/v1/forecast",
      "requiredScope": "weather:read:ap-southeast"
    }
  },
  "x-required-scope": "weather:query:data",
  "paths": {
    "/forecast": {
      "get": {
        "summary": "Get weather forecast with comprehensive rate limiting and cost tracking",
        "description": "This operation demonstrates all three operation-level extensions: loop guard, cost per call, and quota.",
        "operationId": "getForecast",
        "x-loop-guard": {
          "max_iterations": 10,
          "backoff_ms": 100
        },
        "x-cost-per-call": 0.001,
        "x-quota": {
          "limit": 1000,
          "window_seconds": 3600
        },
        "responses": {
          "200": {
            "description": "Successful forecast response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temperature": { "type": "number" },
                    "conditions": { "type": "string" },
                    "humidity": { "type": "number" }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/current": {
      "get": {
        "summary": "Get current weather conditions",
        "description": "Alternative operation with different loop guard and quota settings.",
        "operationId": "getCurrentConditions",
        "x-loop-guard": {
          "max_iterations": 5,
          "backoff_ms": 50
        },
        "x-cost-per-call": 0.0005,
        "x-quota": {
          "limit": 2000,
          "window_seconds": 3600
        },
        "responses": {
          "200": {
            "description": "Current conditions response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "temp": { "type": "number" },
                    "condition": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
