{
  "$comment": "Example fragment demonstrating all rate limiting and monitoring extensions (x-seam-schema, x-loop-guard, x-cost-per-call, x-quota, x-upstream-map)",
  "title": "Rate Limiting and Monitoring Example Fragment",
  "description": "This example shows a complete SEAM fragment with all rate limiting, loop protection, cost tracking, and upstream mapping fields configured. Demonstrates fragment-root defaults and operation-level overrides.",

  "x-seam-schema": "v1",
  "x-seam-owner": "weather-service",

  "x-loop-guard": {
    "maxRepeats": 10,
    "window": "1h"
  },

  "x-cost-per-call": {
    "amount": 0.001,
    "unit": "credits"
  },

  "x-quota": {
    "amount": 1000,
    "unit": "credits",
    "window": "1h"
  },

  "x-upstream-map": {
    "production": {
      "url": "https://weather-api.production.svc.cluster.local",
      "vaultPath": "rs-manager/rs-manager/seam/routes/weather-service/prod-credentials",
      "injectAs": { "kind": "bearer" }
    },
    "staging": {
      "url": "https://weather-api.staging.svc.cluster.local",
      "vaultPath": "rs-manager/rs-manager/seam/routes/weather-service/staging-credentials",
      "injectAs": { "kind": "bearer" }
    }
  },

  "x-instance-param": "environment",

  "paths": {
    "/weather/{environment}/forecast": {
      "get": {
        "summary": "Get weather forecast with standard rate limits",
        "operationId": "getForecast",
        "x-required-scope": ["weather:read"],

        "responses": {
          "200": {
            "description": "Weather forecast retrieved successfully"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "post": {
        "summary": "Update forecast data with higher cost and stricter limits",
        "operationId": "updateForecast",
        "x-required-scope": ["weather:write"],
        "x-cost-per-call": {
          "amount": 0.01,
          "unit": "credits"
        },
        "x-quota": {
          "amount": 100,
          "unit": "credits",
          "window": "1h"
        },
        "x-loop-guard": {
          "maxRepeats": 5,
          "window": "30m"
        },

        "responses": {
          "200": {
            "description": "Forecast updated successfully"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/weather/{environment}/current": {
      "get": {
        "summary": "Get current weather conditions",
        "operationId": "getCurrentConditions",
        "x-required-scope": ["weather:read"],
        "x-cost-per-call": {
          "amount": 0.002,
          "unit": "credits"
        },

        "responses": {
          "200": {
            "description": "Current conditions retrieved successfully"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  }
}
