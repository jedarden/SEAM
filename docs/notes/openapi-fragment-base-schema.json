{
  "$id": "https://seam.ardenone.com/schemas/openapi-fragment-base-schema.json",
  "title": "OpenAPI 3.1 Fragment Schema",
  "description": "JSON Schema for validating OpenAPI 3.1 paths/components fragments (without SEAM extensions). A fragment contains paths and optionally components, but omits top-level openapi/info/servers which are synthesized during merge.",
  "type": "object",
  "required": ["paths"],
  "properties": {
    "paths": {
      "$ref": "#/$def/paths"
    },
    "components": {
      "$ref": "#/$def/components"
    },
    "openapi": {
      "type": "string",
      "pattern": "^3\\.1\\.[0-9]+$",
      "description": "OpenAPI version string (informational in fragments, synthesized by merge layer)"
    },
    "info": {
      "$ref": "#/$def/info",
      "description": "Info object (informational in fragments, synthesized by merge layer)"
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/$def/server"
      },
      "description": "Server definitions (informational in fragments, synthesized by merge layer)"
    }
  },
  "additionalProperties": false,
  "$def": {
    "paths": {
      "type": "object",
      "minProperties": 1,
      "description": "Path templates to Path Item objects",
      "propertyNames": {
        "type": "string",
        "pattern": "^/",
        "description": "Path templates must begin with /"
      },
      "additionalProperties": {
        "$ref": "#/$def/pathItem"
      }
    },
    "pathItem": {
      "type": "object",
      "description": "Path Item object describing operations on a single path",
      "properties": {
        "$ref": {
          "type": "string",
          "format": "uri-reference",
          "description": "Reference to another Path Item object"
        },
        "$summary": {
          "type": "string",
          "description": "Optional summary for the path item"
        },
        "$description": {
          "type": "string",
          "description": "Optional description for the path item"
        },
        "get": { "$ref": "#/$def/operation" },
        "put": { "$ref": "#/$def/operation" },
        "post": { "$ref": "#/$def/operation" },
        "delete": { "$ref": "#/$def/operation" },
        "options": { "$ref": "#/$def/operation" },
        "head": { "$ref": "#/$def/operation" },
        "patch": { "$ref": "#/$def/operation" },
        "trace": { "$ref": "#/$def/operation" },
        "servers": {
          "type": "array",
          "items": { "$ref": "#/$def/server" }
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$def/parameter" },
              { "$ref": "#/$def/reference" }
            ]
          }
        }
      },
      "patternProperties": {
        "^x-": {
          "description": "Any vendor extension (allowed in base schema)"
        }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["responses"],
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "externalDocs": {
          "type": "object",
          "properties": {
            "description": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          },
          "required": ["url"]
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$def/parameter" },
              { "$ref": "#/$def/reference" }
            ]
          }
        },
        "requestBody": {
          "oneOf": [
            { "$ref": "#/$def/requestBody" },
            { "$ref": "#/$def/reference" }
          ]
        },
        "responses": {
          "$ref": "#/$def/responses"
        },
        "callbacks": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$def/callback" },
              { "$ref": "#/$def/reference" }
            ]
          }
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "security": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "servers": {
          "type": "array",
          "items": { "$ref": "#/$def/server" }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "responses": {
      "type": "object",
      "minProperties": 1,
      "description": "Response definitions per HTTP status code",
      "propertyNames": {
        "type": "string",
        "pattern": "^(default|[1-5][0-9]{2})$"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$def/response" },
          { "$ref": "#/$def/reference" }
        ]
      }
    },
    "response": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$def/header" },
              { "$ref": "#/$def/reference" }
            ]
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/mediaType"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$def/link" },
              { "$ref": "#/$def/reference" }
            ]
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "description": "Reusable components (schemas, parameters, responses, etc.)",
      "properties": {
        "schemas": {
          "type": "object",
          "additionalProperties": {
            "description": "JSON Schema 2020-12 schema definition"
          }
        },
        "responses": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/response"
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/parameter"
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/example"
          }
        },
        "requestBodies": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/requestBody"
          }
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/header"
          }
        },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/securityScheme"
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/link"
          }
        },
        "callbacks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/callback"
          }
        },
        "pathItems": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/pathItem"
          }
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "in", "schema"],
      "properties": {
        "name": { "type": "string" },
        "in": {
          "type": "string",
          "enum": ["query", "header", "path", "cookie"]
        },
        "description": { "type": "string" },
        "required": {
          "type": "boolean",
          "default": false
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "allowEmptyValue": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "type": "string"
        },
        "explode": {
          "type": "boolean"
        },
        "allowReserved": {
          "type": "boolean",
          "default": false
        },
        "schema": {
          "description": "JSON Schema 2020-12 schema definition"
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/mediaType"
          }
        },
        "example": true,
        "examples": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/example"
          }
        }
      },
      "dependencies": {
        "schema": {
          "required": ["schema"],
          "properties": {
            "content": false
          }
        },
        "content": {
          "required": ["content"],
          "properties": {
            "schema": false
          }
        }
      },
      "if": {
        "properties": {
          "in": { "const": "path" }
        },
        "required": ["in"]
      },
      "then": {
        "properties": {
          "required": { "enum": [true] }
        },
        "required": ["required"]
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "requestBody": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "description": { "type": "string" },
        "content": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$def/mediaType"
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "mediaType": {
      "type": "object",
      "properties": {
        "schema": {
          "description": "JSON Schema 2020-12 schema definition"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/encoding"
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "encoding": {
      "type": "object",
      "properties": {
        "contentType": { "type": "string" },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/$def/header" },
              { "$ref": "#/$def/reference" }
            ]
          }
        },
        "style": { "type": "string" },
        "explode": { "type": "boolean" },
        "allowReserved": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "description": { "type": "string" },
        "required": {
          "type": "boolean",
          "default": false
        },
        "deprecated": {
          "type": "boolean",
          "default": false
        },
        "allowEmptyValue": {
          "type": "boolean",
          "default": false
        },
        "style": {
          "type": "string"
        },
        "explode": {
          "type": "boolean"
        },
        "allowReserved": {
          "type": "boolean",
          "default": false
        },
        "schema": {
          "description": "JSON Schema 2020-12 schema definition"
        },
        "content": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/mediaType"
          }
        },
        "example": true,
        "examples": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/example"
          }
        }
      },
      "dependencies": {
        "schema": {
          "required": ["schema"],
          "properties": {
            "content": false
          }
        },
        "content": {
          "required": ["content"],
          "properties": {
            "schema": false
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "value": true,
        "externalValue": { "type": "string", "format": "uri" }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["externalValue"] }
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["operationId"],
      "properties": {
        "operationRef": { "type": "string", "format": "uri" },
        "operationId": { "type": "string" },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "requestBody": true,
        "description": { "type": "string" },
        "server": { "$ref": "#/$def/server" }
      },
      "oneOf": [
        { "required": ["operationRef"] },
        { "required": ["operationId"] }
      ],
      "additionalProperties": false
    },
    "callback": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$def/pathItem"
      }
    },
    "securityScheme": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["apiKey", "http", "oauth2", "openIdConnect", "mutualTLS"]
        },
        "description": { "type": "string" },
        "name": { "type": "string" },
        "in": {
          "type": "string",
          "enum": ["query", "header", "cookie"]
        },
        "scheme": {
          "type": "string",
          "enum": ["basic", "bearer", "digest", "hoba", "mutual", "negotiate", "oauth", "vapid"]
        },
        "bearerFormat": { "type": "string" },
        "flows": {
          "type": "object",
          "properties": {
            "implicit": {
              "$ref": "#/$def/oauthFlow"
            },
            "password": {
              "$ref": "#/$def/oauthFlow"
            },
            "clientCredentials": {
              "$ref": "#/$def/oauthFlow"
            },
            "authorizationCode": {
              "$ref": "#/$def/oauthFlow"
            }
          },
          "additionalProperties": false
        },
        "openIdConnectUrl": { "type": "string", "format": "uri" }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "oauthFlow": {
      "type": "object",
      "required": ["authorizationUrl", "tokenUrl"],
      "properties": {
        "authorizationUrl": { "type": "string", "format": "uri" },
        "tokenUrl": { "type": "string", "format": "uri" },
        "refreshUrl": { "type": "string", "format": "uri" },
        "scopes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string" },
        "description": { "type": "string" },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$def/serverVariable"
          }
        }
      },
      "additionalProperties": false
    },
    "serverVariable": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": { "type": "string" },
        "enum": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "info": {
      "type": "object",
      "required": ["title", "version"],
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "termsOfService": { "type": "string" },
        "contact": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "email": { "type": "string", "format": "email" }
          }
        },
        "license": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "identifier": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "format": "uri-reference"
        },
        "summary": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}