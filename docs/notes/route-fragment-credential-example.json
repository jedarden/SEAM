{
  "$comment": "Complete example SEAM route fragment demonstrating all four credential extensions: x-vault-path, x-inject-as, x-required-scope, and x-credential-probe.",
  "description": "This is a valid example showing all four SEAM credential extensions working together in a single fragment with injected credentials.",
  "x-seam-schema": "v1",
  "x-seam-owner": "user-service",
  "x-api-version": "v1",
  "x-upstream": "https://user-service.internal:8443",
  "x-vault-path": "seam/routes/user-service/api-key",
  "x-inject-as": {
    "kind": "bearer"
  },
  "x-credential-probe": {
    "path": "/health",
    "method": "HEAD",
    "interval": 30
  },
  "x-required-scope": ["read:users", "profile:view"],
  "paths": {
    "/users/{userId}/profile": {
      "get": {
        "summary": "Get user profile",
        "operationId": "getUserProfile",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string" },
                    "username": { "type": "string" },
                    "email": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing credentials"
          },
          "403": {
            "description": "Forbidden - insufficient scope"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check endpoint for credential probing",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy"
          },
          "503": {
            "description": "Service is unhealthy"
          }
        }
      },
      "head": {
        "summary": "HEAD health check for credential probing",
        "operationId": "healthCheckHead",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    }
  }
}