{
  // STATUS 2026-09-18 (bead seam-a2413e9d): APPLIED and verified. This
  // slice lives in the live tailnet policy module — jedarden/declarative-
  // config, terraform/tailscale/policy.hujson — and is now live. The
  // precondition that blocked the 2026-09-06 landing (seam-rs-manager
  // carried tag:k8s because the k8s operator's OAuth client had not been
  // granted tag:seam) was resolved 2026-09-07..09: the client got the
  // console grant, the proxy re-registered, and the policy was applied.
  // Re-verified 2026-09-18: seam-rs-manager carries ["tag:seam"] and no
  // longer tag:k8s; a fresh `terraform plan` against the live ACL is "No
  // changes"; codinghome is pruned from the device's netmap (the
  // tag:codinghome deny tests hold). The module's apply guard
  // (terraform/tailscale/scripts/check-seam-tag.sh) refuses an apply while
  // no device carries tag:seam; the full sequence is
  // terraform/tailscale/SEAM-TAG-RUNBOOK.md in that repo.
  //
  // SEAM's tailnet policy slice.
  //
  // Merge these members into the existing tailnet policy file. The explicit
  // "acls" section is intentional: access to tag:seam is deny-by-default, so
  // tailnet membership alone never grants access to either listener.
  //
  // The operator source set is autogroup:admin: the administrative devices
  // used to inspect the operator-only surface. It is also allowed to use the
  // caller port for operational testing; worker sources are not allowed on
  // the operator port.
  "tagOwners": {
    "tag:seam": ["tag:k8s-operator"],
    "tag:needle-worker": ["autogroup:admin"],
    "tag:devpod": ["autogroup:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "proto": "tcp",
      "src": [
        "tag:needle-worker",
        "tag:devpod",
        "autogroup:admin"
      ],
      "dst": ["tag:seam:8080"]
    },
    {
      "action": "accept",
      "proto": "tcp",
      "src": ["autogroup:admin"],
      "dst": ["tag:seam:8081"]
    }
  ],
  "tests": [
    {
      "src": "tag:needle-worker",
      "proto": "tcp",
      "accept": ["tag:seam:8080"],
      "deny": ["tag:seam:8081"]
    },
    {
      "src": "tag:devpod",
      "proto": "tcp",
      "accept": ["tag:seam:8080"],
      "deny": ["tag:seam:8081"]
    },
    {
      "src": "autogroup:admin",
      "proto": "tcp",
      "accept": ["tag:seam:8080", "tag:seam:8081"]
    }
  ]
}
