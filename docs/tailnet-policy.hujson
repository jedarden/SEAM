{
  // STATUS 2026-09-06 (bead seam-a2413e9d): this slice is merged into the
  // live tailnet policy module — jedarden/declarative-config,
  // terraform/tailscale/policy.hujson — but is deliberately NOT applied
  // yet, and cannot be: seam-rs-manager still carries tag:k8s, because the
  // k8s operator's OAuth client was never granted tag:seam, so Tailscale
  // rejects the proxy's key request (400 "requested tags [tag:seam] are
  // invalid or not permitted") and the operator falls back to its default
  // tag. The module now refuses to apply in that state
  // (terraform/tailscale/scripts/check-seam-tag.sh). Granting the tag,
  // re-registering the proxy, and the resulting access matrix are written
  // up in terraform/tailscale/SEAM-TAG-RUNBOOK.md in that repo.
  //
  // SEAM's tailnet policy slice.
  //
  // Merge these members into the existing tailnet policy file. The explicit
  // "acls" section is intentional: access to tag:seam is deny-by-default, so
  // tailnet membership alone never grants access to either listener.
  //
  // The operator source set is autogroup:admin: the administrative devices
  // used to inspect the operator-only surface. It is also allowed to use the
  // caller port for operational testing; worker sources are not allowed on
  // the operator port.
  "tagOwners": {
    "tag:seam": ["tag:k8s-operator"],
    "tag:needle-worker": ["autogroup:admin"],
    "tag:devpod": ["autogroup:admin"]
  },
  "acls": [
    {
      "action": "accept",
      "proto": "tcp",
      "src": [
        "tag:needle-worker",
        "tag:devpod",
        "autogroup:admin"
      ],
      "dst": ["tag:seam:8080"]
    },
    {
      "action": "accept",
      "proto": "tcp",
      "src": ["autogroup:admin"],
      "dst": ["tag:seam:8081"]
    }
  ],
  "tests": [
    {
      "src": "tag:needle-worker",
      "proto": "tcp",
      "accept": ["tag:seam:8080"],
      "deny": ["tag:seam:8081"]
    },
    {
      "src": "tag:devpod",
      "proto": "tcp",
      "accept": ["tag:seam:8080"],
      "deny": ["tag:seam:8081"]
    },
    {
      "src": "autogroup:admin",
      "proto": "tcp",
      "accept": ["tag:seam:8080", "tag:seam:8081"]
    }
  ]
}
